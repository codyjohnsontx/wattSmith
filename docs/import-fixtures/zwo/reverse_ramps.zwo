<workout_file>
    <author>Wattsmith</author>
    <name>Reverse Ramps</name>
    <description>A warmup that starts high and a cooldown that ends high. PowerLow is always the start.</description>
    <sportType>bike</sportType>
    <workout>
        <textevent timeoffset="0" message="Welcome, this one starts hard"/>
        <Warmup Duration="300" PowerLow="0.8" PowerHigh="0.55"/>
        <SteadyState Duration="900" Power="0.7"/>
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.65"/>
        <textevent timeoffset="1490" message="Done" duration="10"/>
    </workout>
</workout_file>

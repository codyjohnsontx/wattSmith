<workout_file>
    <author>Wattsmith</author>
    <name>Sweet Spot 2x20</name>
    <description>Two long sweet spot efforts with a short spin between them. Written for the Wattsmith importer fixtures.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="SWEETSPOT"/>
        <tag name="FTP BUILDER"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75" pace="0">
            <textevent timeoffset="10" message="Easy spin to start"/>
            <textevent timeoffset="540" message="First effort in one minute"/>
        </Warmup>
        <SteadyState Duration="1200" Power="0.9" Cadence="90">
            <textevent timeoffset="0" message="Settle in at sweet spot" duration="10"/>
            <textevent timeoffset="600" message="Halfway through the first block"/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.5"/>
        <SteadyState Duration="1200" Power="0.9" Cadence="90">
            <textevent timeoffset="1140" message="One minute left" duration="15"/>
        </SteadyState>
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.4"/>
    </workout>
</workout_file>

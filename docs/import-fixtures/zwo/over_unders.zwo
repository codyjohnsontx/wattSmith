<workout_file>
    <author>Wattsmith</author>
    <name>Over-Unders</name>
    <description>Ramped over-under intervals around threshold.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75"/>
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" PowerOnLow="0.95" PowerOnHigh="1.05" PowerOffLow="1.1" PowerOffHigh="1.1"/>
        <SteadyState Duration="300" Power="0.55"/>
        <IntervalsT Repeat="3" OnDuration="240" OffDuration="120" OnPower="0.97" OffPower="0.6"/>
        <Cooldown Duration="600" PowerLow="0.6" PowerHigh="0.4"/>
    </workout>
</workout_file>

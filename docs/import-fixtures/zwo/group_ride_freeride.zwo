<workout_file>
    <author>Wattsmith</author>
    <name>Group Ride Sim</name>
    <description>Structured warmup into an unstructured free ride with a sprint finish.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.7"/>
        <FreeRide Duration="1800" FlatRoad="1">
            <textevent timeoffset="30" message="Ride how you feel"/>
        </FreeRide>
        <MaxEffort Duration="20"/>
        <Freeride Duration="600"/>
    </workout>
</workout_file>

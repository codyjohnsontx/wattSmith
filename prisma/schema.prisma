generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String              @id @default(cuid())
  name           String?
  email          String?             @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]
  athleteProfile AthleteProfile?
  workouts       StructuredWorkout[]
  ftpHistory     AthleteFtpHistory[]
  stravaConnection StravaConnection?
  stravaCacheEntries StravaCacheEntry[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model AthleteFtpHistory {
  id            String   @id @default(cuid())
  userId        String
  ftp           Int
  effectiveFrom DateTime @db.Date
  source        String   @default("manual")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, effectiveFrom])
}

model StravaConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  athleteId            String
  encryptedAccessToken String
  encryptedRefreshToken String
  accessTokenExpiresAt DateTime
  scopes               String[]
  connectedAt          DateTime @default(now())
  lastRefreshedAt      DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([athleteId])
}

model StravaCacheEntry {
  id          String   @id @default(cuid())
  userId      String
  resourceKey String
  payload     Json
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceKey])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AthleteProfile {
  id                              String    @id @default(cuid())
  userId                          String    @unique
  ftp                             Int
  experienceLevel                 String
  weeklyHours                     Float
  availableDays                   String[]
  primaryGoal                     String
  targetEventDate                 DateTime?
  preferredWorkoutDurationMinutes Int
  constraints                     String[]
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  user                            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StructuredWorkout {
  id            String   @id @default(cuid())
  userId        String
  name          String
  description   String
  category      String?
  favorite      Boolean  @default(false)
  ftp           Int
  blocksJson    Json
  cuesJson      Json?
  rationaleJson Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}
